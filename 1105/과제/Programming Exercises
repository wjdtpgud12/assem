1. FindLargest Procedure
Create a procedure named FindLargest that receives two parameters: a pointer to a signed
doubleword array, and a count of the array’s length. The procedure must return the value of
the largest array member in EAX. Use the PROC directive with a parameter list when declaring the procedure. Preserve all registers (except EAX) that are modified by the procedure.
Write a test program that calls FindLargest and passes three different arrays of different
lengths. Be sure to include negative values in your arrays. Create a PROTO declaration for
FindLargest.


INCLUDE Irvine32.inc

FindLargest PROTO, pArray:PTR SDWORD, arraySize:DWORD

.data
array1 SDWORD -8, 12, -3, 7
array2 SDWORD -25, -4, -17
array3 SDWORD 10, -30, 45, 2, -1, 18

msg1 BYTE "Array 1 largest: ",0
msg2 BYTE "Array 2 largest: ",0
msg3 BYTE "Array 3 largest: ",0

.code
main PROC
    INVOKE FindLargest, ADDR array1, LENGTHOF array1
    mov edx, OFFSET msg1
    call WriteString
    call WriteInt
    call Crlf

    INVOKE FindLargest, ADDR array2, LENGTHOF array2
    mov edx, OFFSET msg2
    call WriteString
    call WriteInt
    call Crlf

    INVOKE FindLargest, ADDR array3, LENGTHOF array3
    mov edx, OFFSET msg3
    call WriteString
    call WriteInt
    call Crlf

    exit
main ENDP

FindLargest PROC USES esi ecx edx,
    pArray:PTR SDWORD,
    arraySize:DWORD

    mov esi, pArray
    mov ecx, arraySize

    ; 배열 길이가 0이면 0 반환
    xor eax, eax
    cmp ecx, 0
    je FL_Done

    mov eax, [esi]             ; 첫 번째 원소를 최댓값으로 설정
    add esi, TYPE SDWORD
    dec ecx
    jz FL_Done

FL_Loop:
    mov edx, [esi]
    cmp edx, eax
    jle FL_Next                ; signed 비교
    mov eax, edx

FL_Next:
    add esi, TYPE SDWORD
    loop FL_Loop

FL_Done:
    ret
FindLargest ENDP

END main

2. Chess Board
Write a program that draws an 8  8 chess board, with alternating gray and white squares. You
can use the SetTextColor and Gotoxy procedures from the Irvine32 library. Avoid the use of global variables, and use declared parameters in all procedures. Use short procedures that are
focused on a single task.

INCLUDE Irvine32.inc

DrawSquare PROTO, xPos:DWORD, yPos:DWORD, bgColor:DWORD
DrawBoard PROTO, grayColor:DWORD, whiteColor:DWORD

.code
main PROC
    call Clrscr
    INVOKE DrawBoard, 7, 15       ; 회색(7), 흰색(15)
    mov eax, 0
    call SetTextColor
    exit
main ENDP

; 지정한 위치에 4칸 너비 × 2줄 높이의 정사각형을 출력한다.
DrawSquare PROC USES eax ecx edx esi,
    xPos:DWORD,
    yPos:DWORD,
    bgColor:DWORD

    mov eax, bgColor
    shl eax, 4                    ; 배경색은 상위 4비트
    call SetTextColor

    mov esi, 0
DS_Row:
    mov eax, yPos
    add eax, esi
    mov dh, al
    mov eax, xPos
    mov dl, al
    call Gotoxy

    mov ecx, 4
DS_Column:
    mov al, ' '
    call WriteChar
    loop DS_Column

    inc esi
    cmp esi, 2
    jb DS_Row
    ret
DrawSquare ENDP

; 8×8 체스판의 각 칸 위치와 색을 결정한다.
DrawBoard PROC USES eax,
    grayColor:DWORD,
    whiteColor:DWORD

    LOCAL row:DWORD
    LOCAL col:DWORD
    LOCAL xPos:DWORD
    LOCAL yPos:DWORD
    LOCAL squareColor:DWORD

    mov row, 0
DB_Row:
    mov col, 0
DB_Column:
    ; 각 칸의 화면 좌표: 가로 4칸, 세로 2줄
    mov eax, col
    shl eax, 2
    mov xPos, eax

    mov eax, row
    shl eax, 1
    mov yPos, eax

    ; 행 번호와 열 번호의 합이 짝수이면 회색, 홀수이면 흰색
    mov eax, row
    add eax, col
    test eax, 1
    jnz DB_White

    mov eax, grayColor
    mov squareColor, eax
    jmp DB_Draw

DB_White:
    mov eax, whiteColor
    mov squareColor, eax

DB_Draw:
    INVOKE DrawSquare, xPos, yPos, squareColor

    inc col
    cmp col, 8
    jb DB_Column

    inc row
    cmp row, 8
    jb DB_Row
    ret
DrawBoard ENDP

END main







3. Chess Board with Alternating Colors
This exercise extends Exercise 2. Every 500 milliseconds, change the color of the colored
squares and redisplay the board. Continue until you have shown the board 16 times, using all
possible 4-bit background colors. (The white squares remain white throughout.)

INCLUDE Irvine32.inc

DrawSquare PROTO, xPos:DWORD, yPos:DWORD, bgColor:DWORD
DrawBoard PROTO, coloredColor:DWORD, whiteColor:DWORD

.code
main PROC
    mov ebx, 0                    ; 0~15의 배경색 번호

CB_Loop:
    call Clrscr
    INVOKE DrawBoard, ebx, 15     ; 흰색 칸은 항상 15
    mov eax, 500
    call Delay

    inc ebx
    cmp ebx, 16
    jb CB_Loop

    mov eax, 0
    call SetTextColor
    exit
main ENDP

DrawSquare PROC USES eax ecx edx esi,
    xPos:DWORD,
    yPos:DWORD,
    bgColor:DWORD

    mov eax, bgColor
    shl eax, 4
    call SetTextColor

    mov esi, 0
CBS_Row:
    mov eax, yPos
    add eax, esi
    mov dh, al
    mov eax, xPos
    mov dl, al
    call Gotoxy

    mov ecx, 4
CBS_Column:
    mov al, ' '
    call WriteChar
    loop CBS_Column

    inc esi
    cmp esi, 2
    jb CBS_Row
    ret
DrawSquare ENDP

DrawBoard PROC USES eax,
    coloredColor:DWORD,
    whiteColor:DWORD

    LOCAL row:DWORD
    LOCAL col:DWORD
    LOCAL xPos:DWORD
    LOCAL yPos:DWORD
    LOCAL squareColor:DWORD

    mov row, 0
CDB_Row:
    mov col, 0
CDB_Column:
    mov eax, col
    shl eax, 2
    mov xPos, eax

    mov eax, row
    shl eax, 1
    mov yPos, eax

    mov eax, row
    add eax, col
    test eax, 1
    jnz CDB_White

    mov eax, coloredColor
    mov squareColor, eax
    jmp CDB_Draw

CDB_White:
    mov eax, whiteColor
    mov squareColor, eax

CDB_Draw:
    INVOKE DrawSquare, xPos, yPos, squareColor

    inc col
    cmp col, 8
    jb CDB_Column

    inc row
    cmp row, 8
    jb CDB_Row
    ret
DrawBoard ENDP

END main








4. FindThrees Procedure
Create a procedure named FindThrees that returns 1 if an array has three consecutive values of
3 somewhere in the array. Otherwise, return 0. The procedure’s input parameter list contains a
pointer to the array and the array’s size. Use the PROC directive with a parameter list when
declaring the procedure. Preserve all registers (except EAX) that are modified by the procedure.
Write a test program that calls FindThrees several times with different arrays. 

INCLUDE Irvine32.inc

FindThrees PROTO, pArray:PTR SDWORD, arraySize:DWORD

.data
array1 SDWORD 1, 3, 3, 3, 8
array2 SDWORD 3, 3, 2, 3, 3
array3 SDWORD 3, 3, 3
array4 SDWORD 1, 2, 3, 4, 5

msg BYTE "FindThrees result: ",0

.code
main PROC
    INVOKE FindThrees, ADDR array1, LENGTHOF array1
    call DisplayResult

    INVOKE FindThrees, ADDR array2, LENGTHOF array2
    call DisplayResult

    INVOKE FindThrees, ADDR array3, LENGTHOF array3
    call DisplayResult

    INVOKE FindThrees, ADDR array4, LENGTHOF array4
    call DisplayResult

    exit
main ENDP

DisplayResult PROC
    mov edx, OFFSET msg
    call WriteString
    call WriteDec
    call Crlf
    ret
DisplayResult ENDP

FindThrees PROC USES esi ecx edx,
    pArray:PTR SDWORD,
    arraySize:DWORD

    mov esi, pArray
    mov ecx, arraySize
    xor edx, edx                 ; 연속된 3의 개수
    xor eax, eax                 ; 기본 반환값은 0

FT_Loop:
    cmp ecx, 0
    je FT_Done

    cmp DWORD PTR [esi], 3
    jne FT_Reset

    inc edx
    cmp edx, 3
    je FT_Found
    jmp FT_Next

FT_Reset:
    xor edx, edx

FT_Next:
    add esi, TYPE SDWORD
    dec ecx
    jmp FT_Loop

FT_Found:
    mov eax, 1

FT_Done:
    ret
FindThrees ENDP

END main


5. DifferentInputs Procedure
Write a procedure named DifferentInputs that returns EAX = 1 if the values of its three input
parameters are all different; otherwise, return with EAX = 0. Use the PROC directive with a
parameter list when declaring the procedure. Create a PROTO declaration for your procedure,
and call it five times from a test program that passes different inputs.

INCLUDE Irvine32.inc

DifferentInputs PROTO, value1:DWORD, value2:DWORD, value3:DWORD

.data
resultMsg BYTE "Result: ",0

.code
main PROC
    INVOKE DifferentInputs, 10, 20, 30
    call ShowAnswer

    INVOKE DifferentInputs, 10, 10, 30
    call ShowAnswer

    INVOKE DifferentInputs, 5, 8, 5
    call ShowAnswer

    INVOKE DifferentInputs, 1, 2, 3
    call ShowAnswer

    INVOKE DifferentInputs, 7, 7, 7
    call ShowAnswer

    exit
main ENDP

ShowAnswer PROC
    mov edx, OFFSET resultMsg
    call WriteString
    call WriteDec
    call Crlf
    ret
ShowAnswer ENDP

DifferentInputs PROC,
    value1:DWORD,
    value2:DWORD,
    value3:DWORD

    mov eax, 0

    mov edx, value1
    cmp edx, value2
    je DI_Done

    cmp edx, value3
    je DI_Done

    mov edx, value2
    cmp edx, value3
    je DI_Done

    mov eax, 1

DI_Done:
    ret
DifferentInputs ENDP

END main


6. Exchanging Integers
Create an array of randomly ordered integers. Using the Swap procedure from Section 8.4.6 as a
tool, write a loop that exchanges each consecutive pair of integers in the array.

INCLUDE Irvine32.inc

Swap PROTO, pValue1:PTR DWORD, pValue2:PTR DWORD

.data
intArray DWORD 8, 3, 12, 5, 1, 10, 6, 2
arraySize = LENGTHOF intArray

beforeMsg BYTE "Before swapping: ",0
afterMsg  BYTE "After swapping:  ",0

.code
main PROC
    mov edx, OFFSET beforeMsg
    call WriteString
    mov esi, OFFSET intArray
    mov ecx, arraySize
    call DisplayArray
    call Crlf

    mov esi, 0
    mov ecx, arraySize / 2

EX_Loop:
    ; ESI는 교환할 첫 번째 원소의 인덱스
    mov eax, OFFSET intArray
    lea edx, [eax + esi * TYPE DWORD]
    lea edi, [edx + TYPE DWORD]

    INVOKE Swap, edx, edi

    add esi, 2
    loop EX_Loop

    mov edx, OFFSET afterMsg
    call WriteString
    mov esi, OFFSET intArray
    mov ecx, arraySize
    call DisplayArray
    call Crlf

    exit
main ENDP

; 두 주소가 가리키는 DWORD 값을 서로 교환한다.
Swap PROC USES eax esi edi,
    pValue1:PTR DWORD,
    pValue2:PTR DWORD

    mov esi, pValue1
    mov edi, pValue2

    mov eax, [esi]
    xchg eax, [edi]
    mov [esi], eax
    ret
Swap ENDP

; 배열의 모든 원소를 출력한다.
DisplayArray PROC USES eax ecx esi
DA_Loop:
    mov eax, [esi]
    call WriteDec
    mov al, ' '
    call WriteChar
    add esi, TYPE DWORD
    loop DA_Loop
    ret
DisplayArray ENDP

END main



7. Greatest Common Divisor
Write a recursive implementation of Euclid’s algorithm for finding the greatest common divisor
(GCD) of two integers. Descriptions of this algorithm are available in algebra books and on the
Web. Write a test program that calls your GCD procedure five times, using the following pairs of
integers: (5,20), (24,18), (11,7), (432,226), (26,13). After each procedure call, display the GCD.

INCLUDE Irvine32.inc

GCD PROTO, num1:DWORD, num2:DWORD

.data
msg BYTE "GCD = ",0

.code
main PROC
    INVOKE GCD, 5, 20
    call DisplayGCD

    INVOKE GCD, 24, 18
    call DisplayGCD

    INVOKE GCD, 11, 7
    call DisplayGCD

    INVOKE GCD, 432, 226
    call DisplayGCD

    INVOKE GCD, 26, 13
    call DisplayGCD

    exit
main ENDP

DisplayGCD PROC
    mov edx, OFFSET msg
    call WriteString
    call WriteDec
    call Crlf
    ret
DisplayGCD ENDP

; Euclid's algorithm:
; GCD(a, b) = GCD(b, a MOD b)
; GCD(a, 0) = a
GCD PROC USES edx,
    num1:DWORD,
    num2:DWORD

    LOCAL remainder:DWORD

    mov eax, num2
    cmp eax, 0
    jne GCD_Recurse

    mov eax, num1
    ret

GCD_Recurse:
    mov eax, num1
    xor edx, edx
    div num2
    mov remainder, edx

    INVOKE GCD, num2, remainder
    ret
GCD ENDP

END main





8. Counting Matching Elements
Write a procedure named CountMatches that receives points to two arrays of signed doublewords, and a third parameter that indicates the length of the two arrays. For each element xi
 in
the first array, if the corresponding yi
 in the second array is equal, increment a count. At the end,
return a count of the number of matching array elements in EAX. Write a test program that calls
your procedure and passes pointers to two different pairs of arrays. Use the INVOKE statement
to call your procedure and pass stack parameters. Create a PROTO declaration for CountMatches. Save and restore any registers
(other than EAX) changed by your procedure.

INCLUDE Irvine32.inc

CountMatches PROTO,
    pArray1:PTR SDWORD,
    pArray2:PTR SDWORD,
    arraySize:DWORD

.data
array1 SDWORD 1, 5, 3, 7, 9
array2 SDWORD 1, 2, 3, 4, 9

array3 SDWORD -5, 10, 15, 20
array4 SDWORD -5, 11, 15, 18

msg BYTE "Matching elements: ",0

.code
main PROC
    INVOKE CountMatches, ADDR array1, ADDR array2, LENGTHOF array1
    call ShowCount

    INVOKE CountMatches, ADDR array3, ADDR array4, LENGTHOF array3
    call ShowCount

    exit
main ENDP

ShowCount PROC
    mov edx, OFFSET msg
    call WriteString
    call WriteDec
    call Crlf
    ret
ShowCount ENDP

CountMatches PROC USES esi edi ecx edx,
    pArray1:PTR SDWORD,
    pArray2:PTR SDWORD,
    arraySize:DWORD

    mov esi, pArray1
    mov edi, pArray2
    mov ecx, arraySize
    xor eax, eax

CM_Loop:
    cmp ecx, 0
    je CM_Done

    mov edx, [esi]
    cmp edx, [edi]
    jne CM_Next

    inc eax

CM_Next:
    add esi, TYPE SDWORD
    add edi, TYPE SDWORD
    dec ecx
    jmp CM_Loop

CM_Done:
    ret
CountMatches ENDP

END main





9. Counting Nearly Matching Elements
Write a procedure named CountNearMatches that receives pointers to two arrays of signed doublewords, a parameter that indicates the length of the two arrays, and a parameter that indicates the
maximum allowed difference (called diff) between any two matching elements. For each element
xi
 in the first array, if the difference between it and the corresponding yi
 in the second array is less
than or equal to diff, increment a count. At the end, return a count of the number of nearly matching array elements in EAX. Write a test program that calls CountNearMatches and passes pointers
to two different pairs of arrays. Use the INVOKE statement to call your procedure and pass stack
parameters. Create a PROTO declaration for CountMatches. Save and restore any registers (other
than EAX) changed by your procedure.

INCLUDE Irvine32.inc

CountNearMatches PROTO,
    pArray1:PTR SDWORD,
    pArray2:PTR SDWORD,
    arraySize:DWORD,
    diff:DWORD

.data
array1 SDWORD 10, 20, 30, 40, 50
array2 SDWORD 12, 25, 27, 48, 60

array3 SDWORD -10, 0, 10, 20
array4 SDWORD -7, 3, 15, 30

msg BYTE "Nearly matching elements: ",0

.code
main PROC
    INVOKE CountNearMatches, ADDR array1, ADDR array2, LENGTHOF array1, 5
    call ShowNearCount

    INVOKE CountNearMatches, ADDR array3, ADDR array4, LENGTHOF array3, 5
    call ShowNearCount

    exit
main ENDP

ShowNearCount PROC
    mov edx, OFFSET msg
    call WriteString
    call WriteDec
    call Crlf
    ret
ShowNearCount ENDP

CountNearMatches PROC USES esi edi ecx edx ebx,
    pArray1:PTR SDWORD,
    pArray2:PTR SDWORD,
    arraySize:DWORD,
    diff:DWORD

    mov esi, pArray1
    mov edi, pArray2
    mov ecx, arraySize
    xor ebx, ebx                 ; 일치하는 원소 개수

CNM_Loop:
    cmp ecx, 0
    je CNM_Done

    mov eax, [esi]               ; x
    mov edx, [edi]               ; y

    ; signed 비교로 큰 값과 작은 값을 구분한다.
    cmp eax, edx
    jge CNM_XGreater

    ; x < y이면 y - x
    sub edx, eax
    mov eax, edx
    jmp CNM_Check

CNM_XGreater:
    ; x >= y이면 x - y
    sub eax, edx

CNM_Check:
    ; diff는 음수가 아닌 허용 최대 차이라고 가정한다.
    cmp eax, diff
    ja CNM_Next
    inc ebx

CNM_Next:
    add esi, TYPE SDWORD
    add edi, TYPE SDWORD
    dec ecx
    jmp CNM_Loop

CNM_Done:
    mov eax, ebx
    ret
CountNearMatches ENDP

END main








10. Show Procedure Parameters
Write a procedure named ShowParams that displays the address and hexadecimal value of the
32-bit parameters on the runtime stack of the procedure that called it. The parameters are to be
displayed in order from the lowest address to the highest. Input to the procedure will be a single
integer that indicates the number of parameters to display. For example, suppose the following
statement in main calls MySample, passing three arguments:
INVOKE MySample, 1234h, 5000h, 6543h
Next, inside MySample, you should be able to call ShowParams, passing the number of parameters you want to display:
MySample PROC first:DWORD, second:DWORD, third:DWORD
paramCount = 3
call ShowParams, paramCount
ShowParams should display output in the following format:
Stack parameters:
---------------------------
Address 0012FF80 = 00001234
Address 0012FF84 = 00005000
Address 0012FF88 = 00006543


INCLUDE Irvine32.inc

MySample PROTO, first:DWORD, second:DWORD, third:DWORD
ShowParams PROTO, paramCount:DWORD

.data
heading BYTE "Stack parameters:",0
separator BYTE "---------------------------",0
addressText BYTE "Address ",0
equalsText BYTE " = ",0

.code
main PROC
    INVOKE MySample, 1234h, 5000h, 6543h
    exit
main ENDP

MySample PROC USES eax,
    first:DWORD,
    second:DWORD,
    third:DWORD

    INVOKE ShowParams, 3
    ret
MySample ENDP

ShowParams PROC USES ebx esi edx,
    paramCount:DWORD

    ; ShowParams의 EBP 프레임에서
    ; [EBP]는 호출한 MySample의 EBP 값이다.
    mov esi, [ebp]
    add esi, 8                    ; MySample의 첫 번째 매개변수 주소

    mov edx, OFFSET heading
    call WriteString
    call Crlf

    mov edx, OFFSET separator
    call WriteString
    call Crlf

    mov ebx, paramCount

SP_Loop:
    cmp ebx, 0
    je SP_Done

    ; 매개변수의 주소 출력
    mov edx, OFFSET addressText
    call WriteString
    mov eax, esi
    call WriteHex

    ; 등호와 매개변수 값 출력
    mov edx, OFFSET equalsText
    call WriteString
    mov eax, [esi]
    call WriteHex
    call Crlf

    add esi, TYPE DWORD
    dec ebx
    jmp SP_Loop

SP_Done:
    ret
ShowParams ENDP

END main









